# Development Compose. For the immutable production deployment, use deploy/.
# Generate a distinct secret for each value, e.g. openssl rand -base64 32.
# Empty required values deliberately prevent startup until configured.
CONTROL_TOWER_TOKEN=
CONTROL_TOWER_ADMIN_PASSWORD=
CONTROL_TOWER_DB_ENCRYPTION_KEY=
JOLT_STATE_ENCRYPTION_KEY=

# Every secret also accepts NAME_FILE instead of NAME. Do not set both forms.
# Recovery commands support the corresponding _FILE variables too:
# CONTROL_TOWER_RECOVERY_ADMIN_PASSWORD_FILE
# CONTROL_TOWER_RECOVERY_NODE_TOKEN_FILE
# JOLT_RECOVERY_OPERATIONAL_TOKEN_FILE

PUID=1000
PGID=1000
# Recursively changes ownership of these container paths at startup.
# Leave empty after preparing ownership on the host.
JOLT_OWNED_PATHS=/mnt/files

# Node ports, limits, mounts and authorizations are configured in node/node.docker.yaml.
# If api_tls_cert_file and api_tls_key_file are configured, use HTTPS here:
# NODE_HEALTHCHECK_URL=https://127.0.0.1:8080/readyz

# Optional dedicated secrets (at least 16 characters); blank disables metrics.
NODE_METRICS_TOKEN=
CONTROL_TOWER_METRICS_TOKEN=
