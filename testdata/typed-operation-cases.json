{
 "mount": "nodes/n1/files/mounts/m",
 "policy_sets": {
  "keys-and-executables": [
   {
    "path": "nodes/n1/jobs",
    "capabilities": [
     "create",
     "list"
    ]
   },
   {
    "path": "nodes/n1/files/mounts/m/**",
    "capabilities": [
     "read",
     "list",
     "create",
     "update",
     "delete"
    ]
   },
   {
    "path": "nodes/n1/files/mounts/m/**",
    "capabilities": [
     "deny",
     "read"
    ],
    "file_types": {
     "extensions": [
      "pem"
     ],
     "names": [
      ".env"
     ]
    },
    "visibility": "hidden"
   },
   {
    "path": "nodes/n1/files/mounts/m/**",
    "capabilities": [
     "deny",
     "create",
     "update",
     "delete"
    ],
    "file_types": {
     "classes": [
      "executable"
     ]
    },
    "visibility": "visible"
   }
  ],
  "videos-only": [
   {
    "path": "nodes/n1/jobs",
    "capabilities": [
     "create",
     "list"
    ]
   },
   {
    "path": "nodes/n1/files/mounts/m",
    "capabilities": [
     "list"
    ]
   },
   {
    "path": "nodes/n1/files/mounts/m/movies/**",
    "capabilities": [
     "read",
     "list"
    ],
    "file_types": {
     "classes": [
      "video"
     ]
    },
    "visibility": "visible"
   }
  ]
 },
