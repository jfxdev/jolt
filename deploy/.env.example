# Use the same dated release for both services. Prefer immutable @sha256:digest references.
JOLT_NODE_IMAGE=ghcr.io/jfxdev/jolt-node:YYYY-MM-DD
JOLT_CONTROL_IMAGE=ghcr.io/jfxdev/jolt-control:YYYY-MM-DD
CONTROL_TOWER_PUBLIC_BASE_URL=https://control.example.com
JOLT_MOUNT_PATH=/srv/jolt/files

PUID=1000
PGID=1000
UMASK=002
# WARNING: non-empty entries are recursively chowned to PUID:PGID at every boot.
# Prefer preparing ownership on the host and leave this empty.
JOLT_OWNED_PATHS=

CONTROL_HTTP_BIND=127.0.0.1
CONTROL_HTTP_PORT=8090
NODE_PEER_BIND=0.0.0.0
NODE_PEER_PORT=8443
# Set to https://127.0.0.1:8080/readyz when API TLS is enabled in node.yaml.
# NODE_HEALTHCHECK_URL=https://127.0.0.1:8080/readyz

NODE_CPU_LIMIT=2
NODE_MEMORY_LIMIT=2g
CONTROL_CPU_LIMIT=2
CONTROL_MEMORY_LIMIT=2g
